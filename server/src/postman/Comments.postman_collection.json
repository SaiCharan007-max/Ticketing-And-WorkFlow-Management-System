  "item": [

    {
      "name": "User Add Comment",

      "request": {
        "method": "POST",

        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],

        "url": "{{baseUrl}}/tickets/{{ticketId}}/comments",

        "body": {
          "mode": "raw",

          "raw": "{\n\"content\":\"I am still facing this issue.\"\n}"
        }
      }
    },

    {
      "name": "Staff Add Comment",

      "request": {
        "method": "POST",

        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],

        "url": "{{baseUrl}}/tickets/{{ticketId}}/comments",

        "body": {
          "mode": "raw",

          "raw": "{\n\"content\":\"We are investigating the issue.\"\n}"
        }
      }
    },

    {
      "name": "Admin Add Comment",

      "request": {
        "method": "POST",

        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],

        "url": "{{baseUrl}}/tickets/{{ticketId}}/comments",

        "body": {
          "mode": "raw",

          "raw": "{\n\"content\":\"Escalation approved.\"\n}"
        }
      }
    },

    {
      "name": "Get Comments",

      "request": {
        "method": "GET",

        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],

        "url": "{{baseUrl}}/tickets/{{ticketId}}/comments"
